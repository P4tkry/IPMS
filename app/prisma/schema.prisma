// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(cuid())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  name                   String
  bio                    String?
  image                  String?
  hobbies                String[]                @default([])
  strengths              String[]                @default([])
  weaknesses             String[]                @default([])
  permissions            GlobalPermission[]
  projectMembers         ProjectMember[]
  projectInvitesReceived ProjectInvite[]         @relation("ProjectInvitedUser")
  projectInvitesSent     ProjectInvite[]         @relation("ProjectInvitedBy")
  socialLinks            SocialLink[]
  career                 CareerEntry[]
  accounts               Account[]
  sessions               Session[]
  dashboardEntries       ProjectDashboardEntry[]
  Invite                 Invite[]
  feedbacks              Feedback[]
  taskMessages           TaskMessage[]
}

model Account {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  providerId            String
  accountId             String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  value      String
  expiresAt  DateTime
  identifier String

  @@index([identifier])
}

enum GlobalPermission {
  CREATE_USERS // For inviting new users
  REMOVE_USERS // For removing users
  UPDATE_USERS // For updating user details
  UPLOAD_PHOTOS // For uploading profile photos
  UPLOAD_FILES // For uploading general files

  CREATE_ALL_PROJECTS // For creating new projects
  REMOVE_ALL_PROJECTS // For removing any project
  UPDATE_ALL_PROJECTS // For updating any project
}

enum ProjectPermission {
  USERS_MANAGE // For managing project members and invites
  DASHBOARD_MANAGE // For managing dashboard entries
  DASHBOARD_POST // For posting to dashboard
  TASK_VIEW // For viewing tasks in backlog
  TASKS_CUD // For creating/updating/removing tasks and categories
  TASK_MESSAGE_CRUD // For viewing/sending task messages
  AI_USE // For using AI helpers within a project
  PROJECT_REMOVE // For removing project
  PROJECT_EDIT // For editing project
}

enum SocialPlatform {
  GITHUB
  LINKEDIN
  X
  WEBSITE
}

model Project {
  id                     String                  @id @default(cuid())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isDraft                Boolean                 @default(true)
  tokens                 Int                     @default(10000)
  name                   String?
  tradeName              String?
  category               String?
  goal                   String?
  justification          String?
  mvp                    String[]                @default([])
  kpis                   String[]                @default([])
  milestones             String[]                @default([])
  chances                String[]                @default([])
  threats                String[]                @default([])
  terms                  Json?
  stakeholders           String?                 @map("audience")
  stakeholderEntries     Json?
  inScope                String[]                @default([])
  outScope               String[]                @default([])
  peopleHighAvailability Int?
  peopleLowAvailability  Int?
  budget                 Int?
  description            String?
  logo                   String?                 @map("logoUrl")
  members                ProjectMember[]
  dashboardEntries       ProjectDashboardEntry[]
  invites                ProjectInvite[]
  tasks                  Task[]
  sprints                Sprint[]
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProjectInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  READY_FOR_REVIEW
  IN_REVIEW
  DONE
  REJECTED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectMember {
  id          String              @id @default(cuid())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  role        ProjectRole         @default(EDITOR)
  permissions ProjectPermission[] @default([])
  projectId   String
  userId      String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]              @relation("TaskAssignedMember")
  reviewTasks Task[]              @relation("TaskReviewMember")

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvite {
  id            String              @id @default(cuid())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  status        ProjectInviteStatus @default(PENDING)
  projectId     String
  invitedUserId String
  invitedById   String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedUser   User                @relation("ProjectInvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User                @relation("ProjectInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([projectId, invitedUserId])
  @@index([projectId])
  @@index([invitedUserId])
}

model ProjectDashboardEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String?
  content   String
  tags      String[] @default([])
  urgent    Boolean  @default(false)
  projectId String
  authorId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
}

model Task {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  title            String
  description        String?
  userStory          String?
  acceptanceCriteria String?
  taskNumber       Int
  status           TaskStatus     @default(TODO)
  priority         TaskPriority   @default(MEDIUM)
  completionDescription String?
  completionLinks     String[]    @default([])
  completionFiles     String[]    @default([])
  deadline         DateTime?
  pertX            Float?
  pertY            Float?
  projectId        String
  assignedMemberId String?
  reviewMemberId   String?
  dependentTaskId  String?
  categoryId       String
  sprintId         String?
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedMember   ProjectMember? @relation("TaskAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  reviewMember     ProjectMember? @relation("TaskReviewMember", fields: [reviewMemberId], references: [id], onDelete: SetNull)
  dependentTask    Task?          @relation("TaskDependency", fields: [dependentTaskId], references: [id], onDelete: SetNull)
  blockingTasks    Task[]         @relation("TaskDependency")
  category         TaskCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sprint           Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  messages         TaskMessage[]

  @@index([projectId])
  @@index([assignedMemberId])
  @@index([reviewMemberId])
  @@index([dependentTaskId])
  @@index([categoryId])
  @@index([sprintId])
  @@unique([categoryId, taskNumber])
}

model TaskMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String
  taskId    String
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model Sprint {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  sprintNumber Int
  startDate    DateTime
  endDate      DateTime
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([projectId])
}

model SocialLink {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  platform  SocialPlatform
  url       String
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

model Invite {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  token       String   @unique
  email       String
  name        String
  expiresAt   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([createdById])
}

model CareerEntry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  startDate   DateTime
  position    String
  companyName String
  duration    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  email     String?
  category  String?
  message   String
  page      String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model TaskCategory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  code        String   @unique
  color       String   @default("#f97316")
  icon        String?
  description String?
  tasks       Task[]
}
