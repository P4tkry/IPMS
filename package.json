{
  "name": "ipms",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "dev:log": "pnpm --filter app dev > app/next-dev.log 2>&1",
    "build": "pnpm -r build",
    "lint": "pnpm --filter app lint",
    "prisma:generate": "pnpm --filter app exec prisma generate",
    "prisma:migrate": "pnpm --filter app exec prisma migrate dev",
    "test:e2e": "pnpm --filter app test:e2e",
    "postinstall": "pnpm --filter app exec prisma generate",
    "create:admin": "cd app && node scripts/create-admin.js"
  }
}
